        {
            "name": "Sticky Note",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                -40,
                160
            ],
            "parameters": {
                "content": "## WF12 - Outreach Send\\n\\nSends outreach mail that is ALREADY WRITTEN as a Gmail draft. It never composes anything.\\n\\nEvery pacing rule lives in `outreach_send_claim()` in Supabase: Monday from 13:00, Friday until 12:00, otherwise 09:00-16:30, never at the weekend, max 8 a day, a random 24-53 minute gap, plus a kill switch (`outreach_send_state.gepauzeerd`). Polling more often than every 10 minutes therefore sends no extra mail.\\n\\nEditing a draft in Gmail changes what ships. Deleting a draft cancels the send.\\n\\nTo stop everything: set `gepauzeerd = true` in `outreach_send_state`, or the toggle in /ops. Deactivating this workflow also works but is the blunter tool.",
                "height": 340,
                "width": 460,
                "color": 4
            },
            "id": "aca0d127-d86f-421e-b19e-212dd86ab65c"
        }
    ],
