l().map((i) => pick(i.json)).filter((m) => m.id);\nreturn [{ json: { messages } }];"}},{"id":"1db5753a-d68b-4357-8d2f-487d0b7d4cf6","name":"Sync with Supabase","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[672,0],"parameters":{"method":"POST","url":"https://pcoyafgsirrznhmdaiji.supabase.co/functions/v1/outreach-mail-sync","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify({ messages: $json.messages }) }}","options":{"timeout":150000}},"credentials":{"httpHeaderAuth":{"id":"aiABzg04zbeDSXRc","name":"Supabase Edge Functions — Shared Secret"}}},{"id":"5e707bc9-687d-495e-9bbf-77ac127e2770","name":"Each draft","type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[896,0],"parameters":{"fieldToSplitOut":"drafts"}},{"id":"b28bf1b6-c1f9-4a4b-8b23-a305fa3059a1","name":"Gmail: create draft in thread","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1120,0],"parameters":{"resource":"draft","operation":"create","subject":"={{ $json.subject }}","emailType":"text","message":"={{ $json.body }}","options":{"threadId":"={{ $json.thread_id }}","sendTo":"={{ $json.to }}","fromAlias":"sjoerd@cairnly.io"}},"credentials":{"gmailOAuth2":{"id":"gZNJOlpTQDgS6ydP","name":"Gmail account"}},"webhookId":"75d6c1f7-c743-46d9-b0a6-dbadae596d64"},{"id":"407bdb93-c77d-4f41-8822-b3a33e4c4314","name":"Record draft id","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[1344,0],"parameters":{"method":"POST","url":"https://pcoyafgsirrznhmdaiji.supabase.co/functions/v1/outreach-mail-sync","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify({ action: \"draft_created\", mail_id: $(\"Each draft\").item.json.mail_id, draft_id: $json.id }) }}","options":{"timeout":30000}},"credentials":{"httpHeaderAuth":{"id":"aiABzg04zbeDSXRc","name":"Supabase Edge Functions — Shared Secret"}}},{"id":"d4e39385-eea3-43a6-9546-838c5f7a5f39","name":"Sticky Note 02e62ebb","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[608,0],"parameters":{"content":"## WF11 - Outreach Mail Sync\n\nLeest elke 15 minuten de mail van de laatste 3 dagen en stuurt die naar de Supabase-functie `outreach-mail-sync`. Die koppelt elke mail aan een bureau uit `outreach_prospects`, dedupliceert op Gmail-id, zet statussen (verzonden / opvolging / gereageerd / afgewezen / codes_gemint), laat Claude een antwoord classificeren en een concept schrijven, en mint een testcode als een bureau erom vraagt.\n\nDe concepten komen terug en worden hier als **Gmail-draft in de thread** gezet. Er wordt NOOIT automatisch verzonden.\n\nLogica en huisregels staan in git: `supabase/functions/outreach-mail-sync/` en `_shared/outreachReply.ts`. Spec: `docs/superpowers/specs/2026-09-11-outreach-mail-sync-design.md`.","color":4}}],"connections":{"Every 15 minutes":{"main":[[{"node":"Gmail: mail of the last 3 days","type":"main","index":0}]]},"Gmail: mail of the last 3 days":{"main":[[{"node":"Bundle messages","type":"main","index":0}]]},"Bundle messages":{"main":[[{"node":"Sync with Supabase","type":"main","index":0}]]},"Sync with Supabase":{"main":[[{"node":"Each draft","type":"main","index":0}]]},"Each draft":{"main":[[{"node":"Gmail: create draft in thread","type":"main","index":0}]]},"Gmail: create draft in thread":{"main":[[{"node":"Record draft id","type":"main","index":0}]]}},"nodeGroups":[],"settings":{"executionOrder":"v1","availableInMCP":true},"staticData":null,"pinData":null,"meta":{"aiBuilderAssisted":true,"builderVariant":"mcp"},"tags":[],"shared":[{"role":"workflow:owner","workflowId":"JXOW9lwv9MKPp9Cy","projectId":"IRGhJlz0HuarxdVs","project":{"id":"IRGhJlz0HuarxdVs","name":"Cairnly","type":"team","icon":{"type":"icon","value":"layer-group"},"description":"","customTelemetryTags":[],"creatorId":null,"createdAt":"2025-06-17T10:11:12.163Z