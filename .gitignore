# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.superpowers/

# Local archive of old handoffs / backups
/_archive/

# Ad-hoc production data dumps (contain user data — never commit)
scratchpad_n8n/
scratchpad*/
exec_*.json

# User report archives must never enter git history
handoff/**/*.pdf
handoff/*.pdf
*.pdf
# ...except the specimen served on /partners/voorbeeldrapport. It is a
# fabricated persona, holds no user data, and has to ship in the build or the
# page 404s. Keep this negation narrow: one directory, nothing else.
!public/partners/*.pdf

# One-off design drops should never be committed at root
/*.zip
*.plugin

# TypeScript incremental build output — never source.
tsconfig*.tsbuildinfo
